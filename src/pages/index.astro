---
import Base from '../layouts/Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SignalCore from '../components/visual/SignalCore.astro';
import Features from '../components/sections/Features.astro';
import AppPreview from '../components/interactive/AppPreview.svelte';
import {release} from '../config/releases';
---
<Base>
  <Header />
  <main id="conteudo">
    <section id="inicio" class="hero wrap">
      <div class="hero-topline"><span>NEXUS // SIGNAL</span><span>UM NOVO SINAL. UM NOVO ESPAÇO.</span><span class="hero-edition">DESKTOP EXPERIENCE — 001</span></div>
      <div class="hero-content"><div class="hero-copy"><div class="release-badge"><i></i>NEXUS DESKTOP <span>/</span> {release.channel.toUpperCase()}</div><h1><span>SUA CONEXÃO.</span><span>SEU <em>ESPAÇO.</em></span></h1><p>Mensagens, chamadas e compartilhamento de tela em uma experiência desktop criada para quem quer se conectar sem complicações.</p><div class="hero-actions"><a class="button primary" href={release.installer}><svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="m1 3 8-1v7H1zm10-1 8-1v8h-8zM1 11h8v7l-8-1zm10 0h8v8l-8-1z"/></svg>Baixar para Windows <span>↗</span></a><a class="text-link" href="#recursos">Explorar recursos <span>↓</span></a></div><div class="hero-meta"><span class="meta-value">v{release.version}</span><span aria-hidden="true">·</span><span class="meta-value">WINDOWS {release.architecture.toUpperCase()}</span><span class="meta-separator" aria-hidden="true">·</span><span class="meta-description">FEITO PARA O SEU DESKTOP</span></div></div><SignalCore /></div>
      <div class="hero-bottom"><a href="#recursos"><span class="scroll-icon">↓</span> CONTINUE A EXPERIÊNCIA</a><span>CONEXÕES REAIS. SEM COMPLICAÇÕES.</span><span class="signal-status"><i></i> SIGNAL ONLINE</span></div>
    </section>
    <div class="principles"><div class="wrap"><span>CONVERSE SEM BARREIRAS</span><i>✳</i><span>COMPARTILHE SEU MUNDO</span><i>✳</i><span>SEJA VOCÊ MESMO</span><i>✳</i><span>ENCONTRE SEU ESPAÇO</span></div></div>
    <Features />
    <section id="aplicativo" class="app-section section"><div class="wrap"><div class="section-top"><span class="eyebrow">02 / NEXUS UI 2.0</span><span class="section-index">UM ESPAÇO QUE PARECE SEU.</span></div><div class="section-heading"><h2>Familiar no primeiro clique.<br/><span>Seu em cada detalhe.</span></h2><p>Uma interface que dá espaço ao que importa.<br/>Explore o aplicativo e encontre seu tema.</p></div><div data-reveal><AppPreview client:visible /></div></div></section>
    <section id="tecnologia" class="section tech-section wrap"><div class="tech-intro"><span class="eyebrow">03 / POR TRÁS DA EXPERIÊNCIA</span><h2>Engenharia sólida.<br/><span>Conexão natural.</span></h2><p>A tecnologia cuida dos detalhes.<br/>Você cuida da conversa.</p><a href={release.repository} class="text-link" target="_blank" rel="noreferrer">Conheça o projeto no GitHub <span>↗</span></a></div><div class="tech-list">{[['RUST + TAURI 2','Feito para o desktop.','Uma base nativa para uma experiência dedicada ao Windows.'],['WEBRTC','De uma pessoa para outra.','Voz e compartilhamento de tela com conexão P2P.'],['SQLITE','Seu histórico, por perto.','Armazenamento local para suas conversas.'],['ATUALIZAÇÕES ASSINADAS','Evolução com integridade.','Assinaturas para verificar a origem das atualizações.']].map(([tag,title,desc],i)=><article data-reveal><span class="tech-number">0{i+1}</span><div><span class="tech-tag">{tag}</span><h3>{title}</h3><p>{desc}</p></div><span class="tech-plus" aria-hidden="true">+</span></article>)}</div></section>
    <section id="download" class="download-section"><div class="download-lines" aria-hidden="true"></div><div class="wrap download-inner"><span class="eyebrow"><i></i> SEU PRÓXIMO PONTO DE ENCONTRO</span><h2>PRONTO PARA<br/>SE <span>CONECTAR?</span></h2><p>Seu espaço está aqui. A próxima conversa também.</p><a class="button primary" href={release.installer}>Baixar NEXUS para Windows <span>↗</span></a><div class="download-details">v{release.version} {release.channel} <span>·</span> Windows {release.architecture} <span>·</span> <a href={release.latest}>Ver release oficial ↗</a></div></div></section>
  </main>
  <Footer />
</Base>
