px}.policy-text li{padding-left:6px;margin:0 0 18px}.policy-text li::marker{color:var(--accent)}.policy-text code{font-size:12px;border:1px solid var(--line);padding:2px 5px;border-radius:3px;background:var(--surface);overflow-wrap:anywhere}.storage-note{background:var(--surface);border:1px solid var(--line);border-left:2px solid var(--accent);border-radius:4px;padding:23px 25px;margin:26px 0}.storage-note h3{font-family:var(--display);font-size:18px;font-weight:500;margin:0 0 13px}.storage-note p{margin:0;font-size:13px}.document-back{margin-top:0}
