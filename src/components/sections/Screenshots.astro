---
import {screenshots} from '../../config/screenshots';
const available = screenshots.filter(item => item.asset !== null);
---
{available.length > 0 && <div class="screenshots" aria-label="Capturas reais do NEXUS Desktop">
  {available.map(item => item.asset && <figure data-reveal><img src={item.asset.src} alt={item.alt} width={item.asset.width} height={item.asset.height} loading="lazy" decoding="async" /><figcaption>{item.label} <span>Captura real do aplicativo</span></figcaption></figure>)}
</div>}
<style>
  .screenshots{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin-top:48px}figure{margin:0;min-width:0}img{display:block;width:100%;height:auto;max-height:560px;object-fit:contain;background:var(--surface);border:1px solid #ffffff20;border-radius:8px;box-shadow:0 20px 65px #0004;transition:border-color .3s}figure:hover img{border-color:#b8495a70}figcaption{display:flex;justify-content:space-between;gap:12px;font-size:12px;margin-top:14px}figcaption span{color:var(--muted);font-size:11px}@media(max-width:650px){.screenshots{grid-template-columns:1fr;gap:28px}}@media(prefers-reduced-motion:reduce){img{transition:none}}
</style>
