  @media(max-width:700px){.privacy{padding-top:100px;padding-bottom:55px}.privacy-heading{padding-bottom:35px}.privacy-heading>.eyebrow{margin-top:29px;font-size:9px;letter-spacing:.8px}.privacy h1{font-size:clamp(46px,11vw,64px);letter-spacing:-2.7px;margin-bottom:23px}.lead{font-size:14px;line-height:1.85}.document-meta{font-size:10px;gap:6px 18px;margin-top:25px}.privacy-layout{display:block;margin-top:30px}.contents{margin-bottom:44px}.contents nav{position:static}.contents ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 18px;margin-top:16px}.contents a{font-size:11px;gap:8px;min-height:63px;align-items:center;padding:11px 0}.contents a>span{font-size:9px}.policy-text section{padding-bottom:30px;margin-bottom:30px;scroll-margin-top:8px}.policy-text h2{font-size:26px;letter-spacing:-.7px;margin-top:13px}.policy-text p,.policy-text li{font-size:13px;line-height:1.95}.storage-note{padding:20px 18px}.storage-note p{font-size:13px}.section-number{font-size:9px;letter-spacing:1px}}
